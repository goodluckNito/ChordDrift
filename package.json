{
  "name": "chord-drift",
  "version": "0.1.0",
  "private": true,
  "description": "Seeded generator for 'chord drift' pieces: voices bloom from unison, glide through a voice-led chord progression, and converge again. Live player + deterministic video export.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "score": "tsx scripts/score.ts",
    "export": "tsx scripts/export.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
