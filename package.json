{
  "name": "chord-drift",
  "version": "0.1.0",
  "private": true,
  "description": "Seeded generator for 'chord drift' pieces: voices bloom from unison, glide through a voice-led chord progression, and converge again. Live player + deterministic video export.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "score": "tsx scripts/score.ts",
    "export": "tsx scripts/export.ts",
    "stats": "tsx scripts/stats.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/major-mono-display": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "lz-string": "^1.5.0",
    "mp4-muxer": "^5.2.2"
  }
}
